{
  "simulation_params": {
    "initialize_year": 2025,
    "lifecycle_duration": 5,
    "num_lcs": 2,
    "lam_target": 1.5,
    "min_arrival_trop_days": 7.0
  },
  "inputs": {
    "use_duckdb": true,
    "use_s3": true,
    "rel_prob_file": "s3://stormsim/data/lcgen/Relative_probability_bins_Atlantic 4.csv",
    "storm_id_prob_file": "s3://stormsim/data/chs-files/regional-files/CHS-NA_Master_Track_Table.csv"
  },
  "outputs": {
    "storage_type": "s3",
    "filename": "lambda_s3_results.csv",
    "s3_bucket": "stormsim",
    "s3_prefix": "outputs/lcgen"
  },
  "s3_config": {
    "endpoint": "http://minio:9000",
    "access_key": "minioadmin",
    "secret_key": "minioadmin"
  },
  "runtime": {
    "validate_lambda": true
  }
}
